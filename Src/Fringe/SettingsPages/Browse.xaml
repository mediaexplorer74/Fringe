<Page
    x:Class="App3.SettingsPages.Browse"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App3.SettingsPages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid HorizontalAlignment="Stretch" AutomationProperties.Name="Browse">
        <Grid HorizontalAlignment="Stretch" Margin="40,32,40,0" MaxWidth="720">
            <TextBlock x:Name="PageTitle" Text="Browse" FontWeight="Medium" Margin="4,32,0,0" FontSize="32" FontFamily="HarmonyOS Sans SC"/>
        </Grid>
        <ScrollViewer Name="ScrollViewer" IsTabStop="False" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" Margin="0,116,0,0">
            <Grid>
                <StackPanel MaxWidth="720" Margin="40,0,40,32">
                    <Grid HorizontalAlignment = "Stretch" Margin = "0,6,0,0" MinHeight = "68" MaxHeight = "68" Height = "68">
                        <Button IsTabStop="False" HorizontalAlignment="Stretch" MinHeight="68" MaxHeight="68" Height="68" Margin="0,0,0,0"/>
                        <TextBlock FontFamily="HarmonyOS Sans SC" FontSize = "16" Text = "Browser core" Margin = "26,0,0,0" VerticalAlignment = "Center" 
                                   HorizontalAlignment = "Left" />
                        <Grid Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,26,0" HorizontalAlignment="Right">
                            <Grid>
                                <ComboBox AutomationProperties.Name="Browser core" FontFamily="HarmonyOS Sans SC" 
                                          Name = "WebView_Selection" SelectionChanged="WebView_SelectionChanged" Width="150" Margin="0,0,0,0" 
                                          VerticalAlignment = "Center" HorizontalAlignment = "Right" >
                                    <x:String>Chromium</x:String>
                                    <x:String>EdgeHTML</x:String>
                                </ComboBox>
                            </Grid>
                            <Button FontFamily="HarmonyOS Sans SC"  Name="Restart_Button" Visibility="Collapsed" 
                                    Style="{StaticResource AccentButtonStyle}" Margin="4,0,0,0" Content="Restart" Click="Restart"/>
                        </StackPanel>
                    </Grid>
                    <Grid HorizontalAlignment = "Stretch" Margin = "0,6,0,0" MinHeight = "68" MaxHeight = "68" Height = "68">
                        <Button IsTabStop="False" HorizontalAlignment="Stretch" MinHeight="68" MaxHeight="68" Height="68" Margin="0,0,0,0"/>
                        <TextBlock FontFamily="HarmonyOS Sans SC" FontSize = "16" Text = "Start Page" Margin = "26,0,0,0"
                                   VerticalAlignment = "Center" HorizontalAlignment = "Left" />
                        <Grid Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,26,0" HorizontalAlignment="Right">
                            <Grid>
                                <ComboBox AutomationProperties.Name="Start Page" FontFamily="HarmonyOS Sans SC" Name = "Home_Selection" 
                                          SelectionChanged="Home_Selection_SelectionChanged" Width="150" Margin="0,0,0,0"
                                          VerticalAlignment = "Center" HorizontalAlignment = "Right" >
                                    <x:String>New Tab</x:String>
                                    <x:String>Customize</x:String>
                                </ComboBox>
                            </Grid>
                            <Button AutomationProperties.Name="Change the start page" FontFamily="HarmonyOS Sans SC" Name="SetHome_Button" 
                                    Visibility="Collapsed" Margin="4,0,0,0" Content="Change" Click="SetHome_Button_Click">
                                <Button.Flyout>
                                    <Flyout x:Name="Set_HomeLink_Flyout" Placement="TopEdgeAlignedRight">
                                        <StackPanel MinWidth="280" MaxWidth="280" Width="280">
                                            <Grid HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                                <TextBlock FontFamily="HarmonyOS Sans SC" Text="URL" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <TextBox FontFamily="HarmonyOS Sans SC" AutomationProperties.Name="URL" 
                                                         Name="Home_Link" HorizontalAlignment="Right" Width="240" MinWidth="240" MaxWidth="240" />
                                            </Grid>
                                            <Button FontFamily="HarmonyOS Sans SC" Content="Change" 
                                                    Width="64" IsEnabled="True" VerticalAlignment="Top" 
                                                    HorizontalAlignment="Right" Margin="0,0,0,0" Click="SetHome_Complete" Style="{StaticResource AccentButtonStyle}"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid HorizontalAlignment = "Stretch" Margin = "0,6,0,0" MinHeight = "68" MaxHeight = "68" Height = "68">
                        <Button IsTabStop="False" HorizontalAlignment="Stretch" MinHeight="68" MaxHeight="68" Height="68" Margin="0,0,0,0"/>
                        <TextBlock FontFamily="HarmonyOS Sans SC" FontSize = "16" Text = "Default search engine" Margin = "26,0,0,0" 
                                   VerticalAlignment = "Center" HorizontalAlignment = "Left" />
                        <Grid Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,26,0" HorizontalAlignment="Right">
                            <Grid>
                                <ComboBox FontFamily="HarmonyOS Sans SC" AutomationProperties.Name="Default search engine" 
                                          Name = "Search_Selection" SelectionChanged="Search_SelectionChanged" Width="150" 
                                          Margin="0,0,0,0" VerticalAlignment = "Center" HorizontalAlignment = "Right" >
                                    <x:String>Bing</x:String>
                                    <x:String>Baidu</x:String>
                                    <x:String>Google</x:String>
                                    <x:String>Sogou</x:String>
                                    <x:String>360</x:String>
                                    <x:String>Customize</x:String>
                                </ComboBox>
                            </Grid>
                            <Button FontFamily="HarmonyOS Sans SC" AutomationProperties.Name="Change the search engine" 
                                    Name="SetSearch_Button" Visibility="Collapsed" Margin="4,0,0,0" Content="Change Search Engine" Click="SetSearch_Click">
                                <Button.Flyout>
                                    <Flyout x:Name="Set_SearchLink_Flyout" Placement="TopEdgeAlignedRight">
                                        <StackPanel MinWidth="280" MaxWidth="280" Width="280">
                                            <Grid HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                                <TextBlock FontFamily="HarmonyOS Sans SC" Text="URL" VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"/>
                                                <TextBox FontFamily="HarmonyOS Sans SC" AutomationProperties.Name="URL"
                                                         Name="Search_Link" HorizontalAlignment="Right" Width="240" MinWidth="240" MaxWidth="240" />
                                            </Grid>
                                            <Button FontFamily="HarmonyOS Sans SC" Content="Change" Width="64" IsEnabled="True" 
                                                    VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,0,0" 
                                                    Click="SetSearch_Complete" Style="{StaticResource AccentButtonStyle}"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
					</Grid>
                    <TextBlock FontFamily="HarmonyOS Sans SC" FontSize = "14" FontWeight = "Bold" Text = "Privacy settings" Margin = "6,12,0,0" />
					<Grid HorizontalAlignment = "Stretch" Margin = "0,6,0,0" MinHeight = "68" MaxHeight = "68" Height = "68">
						<Button IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0"/>
						<TextBlock FontFamily="HarmonyOS Sans SC" FontSize = "16" Text = "Disable JavaScript" Margin = "26,0,0,0" 
                                   VerticalAlignment = "Center" HorizontalAlignment = "Left" />
						<Grid Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        <ToggleSwitch AutomationProperties.Name="Disable JavaScript" FontFamily="HarmonyOS Sans SC"
                                      Name="ForbidJavaScript_Switch" 
                                      Toggled="ForbidJavaScript_Switch_Toggled" Margin="0,0,-52,0" VerticalAlignment = "Center" HorizontalAlignment = "Right" />
					</Grid>
					<Grid HorizontalAlignment = "Stretch" Margin = "0,6,0,0" MinHeight = "68" MaxHeight = "68" Height = "68">
						<Button IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0"/>
                        <TextBlock FontFamily="HarmonyOS Sans SC" FontSize = "16" Text = "Automatically save password" Margin = "26,0,0,0" 
                                   VerticalAlignment = "Center" HorizontalAlignment = "Left" />
						<Grid Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        <ToggleSwitch AutomationProperties.Name="Automatically save password" FontFamily="HarmonyOS Sans SC" Name="AutoSavePassword_Switch"
                                      Toggled="AutoSavePassword_Switch_Toggled" Margin="0,0,-52,0" VerticalAlignment = "Center" HorizontalAlignment = "Right" />
					</Grid>
				</StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
