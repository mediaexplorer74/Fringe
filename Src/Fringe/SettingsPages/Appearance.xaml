<Page
    x:Class="App3.SettingsPages.Appearance"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App3.SettingsPages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid HorizontalAlignment="Stretch" AutomationProperties.Name="外观">
        <Grid HorizontalAlignment="Stretch" Margin="40,32,40,0" MaxWidth="720">
            <TextBlock x:Name="PageTitle" Text="外观" FontWeight="Medium" Margin="4,32,0,0" FontSize="32" FontFamily="HarmonyOS Sans SC"/>
        </Grid>
        <ScrollViewer Name="ScrollViewer" IsTabStop="False" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" Margin="0,116,0,0">
            <Grid>
                <StackPanel MaxWidth="720" Margin="40,0,40,32">
                    <Grid HorizontalAlignment = "Stretch" Margin = "0,6,0,0" MinHeight = "68" MaxHeight = "68" Height = "68">
                        <Button IsTabStop="False" HorizontalAlignment="Stretch" MinHeight="68" MaxHeight="68" Height="68" Margin="0,0,0,0"/>
                        <TextBlock FontFamily="HarmonyOS Sans SC" FontSize = "16" Text = "Application theme" Margin = "26,0,0,0" VerticalAlignment = "Center" HorizontalAlignment = "Left" />
                        <Grid Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        <ComboBox FontFamily="HarmonyOS Sans SC" AutomationProperties.Name="Application theme" Name = "Theme_Selection" SelectionChanged="Theme_SelectionChanged" 
                                  Width="150" Margin="0,0,26,0" VerticalAlignment = "Center" HorizontalAlignment = "Right" >
                            <x:String>System theme</x:String>
                            <x:String>Light teme</x:String>
                            <x:String>Dark theme</x:String>
                        </ComboBox>
                    </Grid>
                    <Grid HorizontalAlignment = "Stretch" Margin = "0,6,0,0" MinHeight = "68" MaxHeight = "68" Height = "68">
                        <Button IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0"/>
                        <TextBlock FontFamily="HarmonyOS Sans SC" FontSize = "16" Text = "Tab list" Margin = "26,0,0,0" VerticalAlignment = "Center" 
                                   HorizontalAlignment = "Left" />
                        <Grid Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        <ToggleSwitch FontFamily="HarmonyOS Sans SC" AutomationProperties.Name="Tab list" Name="ShowTabList_Switch" 
                                      Toggled="ShowTabList_Switch_Toggled" Margin="0,0,-52,0" VerticalAlignment = "Center" HorizontalAlignment = "Right" />
                    </Grid>
                    <TextBlock FontFamily="HarmonyOS Sans SC" FontSize = "14" FontWeight = "Bold" Text = "toolbar" Margin = "6,12,0,0" />
                    <Grid HorizontalAlignment = "Stretch" Margin = "0,6,0,0" MinHeight = "68" MaxHeight = "68" Height = "68">
                        <Button IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0"/>
                        <TextBlock FontFamily="HarmonyOS Sans SC" FontSize = "16" Text = "Show favorites" Margin = "26,0,0,0" VerticalAlignment = "Center"
                                   HorizontalAlignment = "Left" />
                        <Grid Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        <ToggleSwitch FontFamily="HarmonyOS Sans SC" AutomationProperties.Name="Show collection" Name="ShowCollection_Switch" 
                                      Toggled="Collection_Toggled" Margin="0,0,-52,0" VerticalAlignment = "Center" HorizontalAlignment = "Right" />
                    </Grid>
                    <Grid HorizontalAlignment = "Stretch" Margin = "0,6,0,0" MinHeight = "68" MaxHeight = "68" Height = "68">
                        <Button IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0"/>
                        <TextBlock FontFamily="HarmonyOS Sans SC" FontSize = "16" Text = "Show history" Margin = "26,0,0,0" 
                                   VerticalAlignment = "Center" HorizontalAlignment = "Left" />
                        <Grid Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        <ToggleSwitch FontFamily="HarmonyOS Sans SC" AutomationProperties.Name="Show history" Name="ShowHistory_Switch" 
                                      Toggled="History_Toggled" Margin="0,0,-52,0" VerticalAlignment = "Center" HorizontalAlignment = "Right" />
                    </Grid>
                    <Grid HorizontalAlignment = "Stretch" Margin = "0,6,0,0" MinHeight = "68" MaxHeight = "68" Height = "68">
                        <Button IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0"/>
                        <TextBlock FontFamily="HarmonyOS Sans SC" FontSize = "16" Text = "Show download" Margin = "26,0,0,0" VerticalAlignment = "Center" HorizontalAlignment = "Left" />
                        <Grid Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        <ToggleSwitch FontFamily="HarmonyOS Sans SC" AutomationProperties.Name="Show download" Name="ShowDownload_Switch" 
                                      Toggled="Download_Toggled" Margin="0,0,-52,0" VerticalAlignment = "Center" HorizontalAlignment = "Right" />
                    </Grid>
                    <Grid HorizontalAlignment = "Stretch" Margin = "0,6,0,0" MinHeight = "68" MaxHeight = "68" Height = "68">
                        <Button IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0"/>
                        <TextBlock FontFamily="HarmonyOS Sans SC" FontSize = "16" Text = "Show fullscreen" Margin = "26,0,0,0" 
                                   VerticalAlignment = "Center" HorizontalAlignment = "Left" />
                        <Grid Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        <ToggleSwitch FontFamily="HarmonyOS Sans SC" AutomationProperties.Name="Show fullscreen" Name="ShowFullScreen_Switch" 
                                      Toggled="FullScreen_Toggled" Margin="0,0,-52,0" VerticalAlignment = "Center" HorizontalAlignment = "Right" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
